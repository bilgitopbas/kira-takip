generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PASSIVE
  DANISMAN
}

enum PaymentStatus {
  PAID
  UNPAID
  PENDING
}

enum AccountType {
  PROPERTY_OWNER
  REAL_ESTATE_AGENT
  LAWYER
  AUTHORIZED_REPRESENTATIVE
  OTHER
}

enum PropertyCountRange {
  RANGE_1_3
  RANGE_3_5
  RANGE_5_10
  RANGE_10_25
  RANGE_25_50
  RANGE_50_PLUS
}

enum PropertyType {
  ARSA
  AVM
  DEPO
  DEVREMULK
  FABRIKA
  KONUT
  OFIS
}

enum TenantType {
  INDIVIDUAL
  CORPORATE
}

enum PaymentFrequency {
  MONTHLY
  YEARLY
}

enum IncreaseType {
  TUFE
  CUSTOM
}

enum Currency {
  TRY
  USD
  EUR
}

model User {
  id              String  @id @default(cuid())
  email           String  @unique
  passwordHash    String?
  googleId        String? @unique
  fullName        String
  phone           String?
  city            String?
  role            Role    @default(CUSTOMER)
  wantsManagement Boolean @default(false)

  accountType      AccountType?
  accountTypeOther String?

  propertyCountRange PropertyCountRange?

  termsAcceptedAt    DateTime?
  marketingConsentAt DateTime?

  trialEndsAt        DateTime
  subscriptionStatus SubscriptionStatus @default(TRIAL)

  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?

  emailVerifiedAt          DateTime?
  emailVerificationToken   String?   @unique
  emailVerificationExpires DateTime?

  notifyPaymentOverdue  Boolean @default(true)
  notifyRenewalUpcoming Boolean @default(true)
  notifyFiveYear        Boolean @default(true)
  notifyMonthlySummary  Boolean @default(true)

  properties     Property[]
  supportTickets SupportTicket[]
  notifications  Notification[]
  accountMembers AccountMember[]
  announcements  Announcement[]  @relation("AnnouncementSender")
  paymentNotices PaymentNotice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model AccountMember {
  id      String @id @default(cuid())
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  email        String  @unique
  fullName     String
  passwordHash String?

  inviteToken        String?   @unique
  inviteTokenExpires DateTime?
  acceptedAt         DateTime?

  createdAt DateTime @default(now())

  @@map("account_members")
}

model Property {
  id      String @id @default(cuid())
  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String

  title        String
  address      String
  city         String?
  district     String?
  squareMeters Float?
  propertyType PropertyType?
  notes        String?
  isOccupied   Boolean       @default(false)

  tenants     Tenant[]
  // Bu mülke birincil olarak bağlı olmayan ama aynı sözleşme kapsamında
  // kiralanan kiracıların bağlantıları
  tenantLinks TenantProperty[]
  expenses    Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, createdAt])
  @@map("properties")
}

model Tenant {
  id         String   @id @default(cuid())
  property   Property @relation(fields: [propertyId], references: [id])
  propertyId String

  fullName String
  phone    String?
  email    String?

  tenantType          TenantType?
  nationalId          String?
  taxNumber           String?
  notificationAddress String?
  notes               String?
  rating              Int?

  monthlyRent            Decimal?          @db.Decimal(10, 2)
  contractStart          DateTime?
  contractEnd            DateTime?
  rentRevisionDate       DateTime?
  rentPaymentDate        DateTime?
  contractDurationMonths Int?
  paymentFrequency       PaymentFrequency?
  increaseType           IncreaseType?
  increaseRate           Decimal?          @db.Decimal(5, 2)
  depositAmount          Decimal?          @db.Decimal(10, 2)
  depositCurrency        Currency?
  contractFileUrl        String?
  // Diskte dosya rastgele bir kimlikle saklanıyor; kullanıcıya gösterilecek
  // orijinal ad (örn. "Kira Sözleşmesi.pdf") ayrıca tutulur.
  contractFileName       String?
  contractNotes          String?

  // Kiracı hâlâ oturuyor mu, tahliye etti mi
  occupancyStatus TenantOccupancyStatus @default(LIVING)

  debts           Debt[]
  payments        Payment[]
  expenses        Expense[]
  tenantNotes     TenantNote[]
  // Kiracının birincil mülkü dışında kiraladığı diğer mülkler.
  // propertyId (birincil) bilerek korundu: yetkilendirme kontrolleri ve
  // mevcut tüm sorgular bu alan üzerinden çalışmaya devam ediyor.
  otherProperties TenantProperty[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@map("tenants")
}

// Bir kiracı aynı sözleşme kapsamında birden fazla mülk kiralayabilir.
// Birincil mülk Tenant.propertyId'de kalır; buradaki kayıtlar EK mülklerdir.
model TenantProperty {
  id         String   @id @default(cuid())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId   String
  property   Property @relation(fields: [propertyId], references: [id])
  propertyId String

  createdAt DateTime @default(now())

  @@unique([tenantId, propertyId])
  @@index([propertyId])
  @@map("tenant_properties")
}

enum TenantOccupancyStatus {
  LIVING
  VACATED
}

// Kiracıya elle düşülen serbest notlar. Aynı hesabı birden fazla kişi
// kullanabildiği için (bkz. AccountMember) notu yazanın e-postası ve adı
// kayıt anında saklanır - üye sonradan silinse bile not sahipsiz kalmaz.
model TenantNote {
  id       String @id @default(cuid())
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String

  content     String
  authorEmail String
  authorName  String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("tenant_notes")
}

model Expense {
  id         String   @id @default(cuid())
  property   Property @relation(fields: [propertyId], references: [id])
  propertyId String
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  tenantId   String?

  description String
  amount      Decimal  @db.Decimal(10, 2)
  date        DateTime
  notes       String?

  createdAt DateTime @default(now())

  @@index([propertyId, date])
  @@map("expenses")
}

model Debt {
  id       String @id @default(cuid())
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String

  year           Int
  month          Int
  amount         Decimal       @db.Decimal(10, 2)
  dueDate        DateTime
  status         PaymentStatus @default(UNPAID)
  // Borcun kapsadığı ay sayısı: 1 = aylık (varsayılan, mevcut tüm kayıtlar),
  // 12 = yıllık peşin. Ödeme planında ve yenileme hatırlatmasında kullanılır.
  periodMonths   Int           @default(1)
  // Aynı "Kiracıyı Borçlandır" işleminde oluşan borçlar aynı kimliği paylaşır.
  // Ödeme planı dönemleri böylece gerçek borçlandırmalara göre ayrılır; sabit
  // 12'şerli gruplama erken zam gibi durumlarda yanlış sınırlar üretiyordu.
  // Eski kayıtlarda boş; onlar için 12'şerli gruplamaya geri düşülür.
  billingGroupId String?

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, year, month])
  @@index([tenantId])
  @@index([dueDate])
  @@index([billingGroupId])
  @@map("debts")
}

model Payment {
  id       String @id @default(cuid())
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String

  debt   Debt?   @relation(fields: [debtId], references: [id])
  debtId String?

  amount         Decimal  @db.Decimal(10, 2)
  paidAt         DateTime @default(now())
  method         String?
  receiptFileUrl String?
  notes          String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([paidAt])
  @@map("payments")
}

model Subscription {
  id     String @id @default(cuid())
  userId String @unique

  propertyCount Int     @default(0)
  monthlyPrice  Decimal @default(0) @db.Decimal(10, 2)

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

model PlatformSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

model ContactRequest {
  id               String   @id @default(cuid())
  name             String
  phone            String
  marketingConsent Boolean  @default(false)
  isRead           Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@map("contact_requests")
}

model BlogPost {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  excerpt        String
  content        String
  coverImageUrl  String?
  readingMinutes Int      @default(5)
  publishedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  @@map("blog_posts")
}

enum SupportTicketStatus {
  OPEN
  CLOSED
}

model SupportTicket {
  id          String              @id @default(cuid())
  user        User                @relation(fields: [userId], references: [id])
  userId      String
  subject     String
  description String
  status      SupportTicketStatus @default(OPEN)
  createdAt   DateTime            @default(now())

  @@index([userId])
  @@map("support_tickets")
}

enum NotificationType {
  PAYMENT_OVERDUE
  RENEWAL_UPCOMING
  FIVE_YEAR_3_MONTHS
  FIVE_YEAR_1_MONTH
  FIVE_YEAR_REACHED
  MONTHLY_SUMMARY
  ANNOUNCEMENT
  NEW_CUSTOMER
  IYZICO_PAYMENT
  EFT_PAYMENT_NOTICE
}

// Admin duyuruları: herkese veya seçilen tek kullanıcıya (push + uygulama içi)
model Announcement {
  id         String   @id @default(cuid())
  title      String
  subtitle   String?
  message    String
  targetId   String? // boş = herkese; doluysa sadece o kullanıcıya
  targetName String? // geçmiş listesinde göstermek için ad-soyad
  createdAt  DateTime @default(now())

  sender   User   @relation("AnnouncementSender", fields: [senderId], references: [id])
  senderId String

  @@map("announcements")
}

model Notification {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id])
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  dedupeKey String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId])
  @@map("notifications")
}

enum PriceIndexType {
  TUFE
  YIUFE
}

model PriceIndex {
  id         String         @id @default(cuid())
  type       PriceIndexType
  year       Int
  month      Int
  indexValue Decimal        @db.Decimal(14, 4)
  fetchedAt  DateTime       @default(now())

  @@unique([type, year, month])
  @@map("price_indices")
}

enum PaymentNoticeStatus {
  PENDING
  CONFIRMED
  REJECTED
}

// Musteri EFT/havale ile odeme yaptigini bildirir; admin onaylayinca
// abonelik acilir. Otomatik aktivasyon YOKTUR (sahte beyani onlemek icin).
model PaymentNotice {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String

  // Havale aciklamasina yazilan benzersiz kod (or. MZN-4F7K)
  referenceCode String  @unique
  propertyCount Int
  months        Int
  amount        Decimal @db.Decimal(10, 2)
  note          String?

  status     PaymentNoticeStatus @default(PENDING)
  reviewedAt DateTime?
  reviewNote String?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("payment_notices")
}
